# ================================================================
# Intelligent Customer Suspension Notification Agent
# Configuration Template
# ================================================================

# Dataset & Persistence
DATASET_PATH=data/customers.csv
DATABASE_PATH=backend/storage/agent_data.db

# Email Service Mode (Default: True for safe simulation mode)
EMAIL_TEST_MODE=true

# SMTP Configuration (Optional: only needed if EMAIL_TEST_MODE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=notifications@example.com

# Optional AI / LLM Personalization
# If left blank, the system automatically uses reliable built-in templates
GEMINI_API_KEY=
LLM_API_KEY=

# Meta WhatsApp Cloud API (Default: True for safe simulation mode)
WHATSAPP_TEST_MODE=true
META_WHATSAPP_API_VERSION=v20.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_TEMPLATE_NAME=service_suspension_notice
